						</div>

						<div class="h-10 w-10 flex items-center justify-center rounded-full border border-green-800 bg-[#112319]/95">
							<Image src={linkImg} alt="Link" width={22} height={22} />
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<div>
