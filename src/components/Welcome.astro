<header>
	<div class="mt-5 flex justify-end items-center mr-15">
		<span class="text-white mr-3">ES</span>
		<label class="relative inline-flex items-center cursor-pointer">
		<input type="checkbox" class="sr-only peer" value="" />
		<div
			class="group peer bg-white rounded-full duration-300 w-14 h-6 ring-2 ring-green-500 after:duration-300 after:bg-green-500 peer-checked:after:bg-red-500 peer-checked:ring-red-500 after:rounded-full after:absolute after:h-4 after:w-4 after:top-1 after:left-1 after:flex after:justify-center after:items-center peer-checked:after:translate-x-8 peer-hover:after:scale-95"
		></div>
		</label>
		<span class="text-white ml-3">EN</span>
	</div>
	<div class="flex justify-center items-center font-mono mt-8 ">
	  <div class="bg-neutral-900 w-5xl h-132 rounded-2xl border border-neutral-700">
		<div class="flex justify-start items-center">
			<div class="bg-red-500 w-4 h-4 flex m-6 rounded-2xl"></div>
