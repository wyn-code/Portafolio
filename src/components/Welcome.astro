---
import "../styles/global.css"
import { Image } from 'astro:assets';
import cvImg from '../image/cv(1).png'
import linkImg from '../image/enlace(1).png'
import ubicacionImg from '../image/local.png'
import gmailImg2 from '../image/gmailbyw.png'
import linkedinImg2 from '../image/linkedin(1).png'
import githubImg2 from '../image/github(1).png'
