				<Image src={githubImg2} alt="Imagen de Github" width={50} height={50}/>
			</a>
		</div>
	</div>
</section>
<section>
	<div>
		<div class="flex justify-center items-center ml-7 mt-10">
			<h1 class="text-white text-3xl m-10 font-semibold">Proyectos</h1>
		</div>

		<div class="flex justify-center items-center font-mono">
			
